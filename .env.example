# iccpanel API root (include /api, do NOT include portal slug)
# Local: http://127.0.0.1:8000/api
# Production: https://iccpanel.com/api  (also add that host to src-tauri/tauri.conf.json connect-src)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Default portal for registration (can still override on the register screen)
# VITE_PORTAL_SLUG=betwise
VITE_PORTAL_SLUG=

# Demo hardware overlay after register: Ctrl+Shift+H, password admin123.
# Off in production cabinet builds.
# VITE_HW_SIMULATOR=true
VITE_HW_SIMULATOR=
