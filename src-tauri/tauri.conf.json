{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Betting Kiosk",
  "version": "0.1.0",
  "identifier": "com.betwise.kiosk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Betting Kiosk",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "fullscreen": true,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "maximizable": false,
        "minimizable": false,
        "closable": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' asset: http://asset.localhost; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000 http://127.0.0.1:5175 http://localhost:5175 http://192.168.29.107:8000 https://iccpanel.com https://staging.iccpanel.com https://backend.kiosk.syscorp.in ipc: http://ipc.localhost https://tauri.localhost http://tauri.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
